{
  "name": "typical90-direct-editorial-link",
  "version": "1.0.1",
  "description": "競プロ典型 90 問に解説リンク（Twitter）を追加する",
  "typeRoots": [
    "types",
    "node_modules/@types"
  ],
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit; eslint 'src/**/*.ts'",
    "lint:fix": "tsc --noEmit; eslint --fix 'src/**/*.ts'",
    "format": "prettier --write **/*.{js,json,ts,html,css}",
    "bundle": "rollup -c",
    "bundle:watch": "rollup -c -w"
  },
  "author": "hotarunx",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hotarunx/typical90-direct-editorial-link/issues"
  },
  "devDependencies": {
    "@rollup/plugin-html": "^2.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/tampermonkey": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "rollup": "^4.60.1",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.99.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
